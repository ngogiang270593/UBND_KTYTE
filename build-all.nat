@echo off
setlocal

cd /d "%~dp0"

echo =========================
echo BUILD FRONTEND
echo =========================
cd frontend
call npm.cmd run build
if errorlevel 1 goto :failed

echo =========================
echo PUBLISH BACKEND
echo =========================
cd ..
dotnet publish backend\backend.csproj -c Release -r win-x64 --self-contained true -o publish\backend
if errorlevel 1 goto :failed

echo =========================
echo BUILD WINDOWS INSTALLER
echo =========================
call npm.cmd run build-app
if errorlevel 1 goto :failed

echo.
echo BUILD SUCCESSFUL
echo Installer: release\UBND_KTYTE Setup 1.1.0.exe
exit /b 0

:failed
echo.
echo BUILD FAILED
exit /b 1
